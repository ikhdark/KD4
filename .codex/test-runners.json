{
  "version": 1,
  "runners": [
    {
      "programs": ["python", "python3", "py"],
      "prefixes": [["scripts/rust_build_status.py", "run-lane"]],
      "options": {"-I": 0, "-B": 0, "-u": 0},
      "allow_extra_args": true,
      "passthrough_after": "--"
    },
    {
      "programs": ["python", "python3", "py"],
      "prefixes": [
        ["scripts/rust_test_runner.py", "run-target"],
        ["scripts/rust_test_runner.py", "run-gate"],
        ["scripts/rust_test_runner.py", "parity"]
      ],
      "options": {"-I": 0, "-B": 0, "-u": 0, "--manifest": 1, "--target-dir": 1, "--profile": 1, "--cargo-profile": 1, "--admission-timeout-seconds": 1},
      "allow_extra_args": true,
      "operations": ["test"],
      "receipt_runner": "rust_test_runner"
    },
    {
      "programs": ["just"],
      "prefixes": [
        ["core-test"], ["core-test-fast"], ["core-test-small"], ["core-test-lane"],
        ["_core-test-lane-reserved"], ["core-gate"], ["core-test-parity"]
      ],
      "allow_extra_args": true,
      "operations": ["test"],
      "receipt_runner": "rust_test_runner"
    },
    {
      "programs": ["just"],
      "prefixes": [
        ["test-fast"], ["test-fast-nosccache"], ["test-lane"], ["test-lane-main"],
        ["test-lane-fast"], ["test-lane-package"], ["validate-crate-focused"],
        ["config-schema-protocol-check"], ["app-server-schema-protocol-check"],
        ["hooks-schema-check"], ["test-slow-boundaries"], ["app-server-runtime-check"],
        ["tui-large-widget-check"], ["app-server-command-exec-check"],
        ["app-server-process-exec-check"], ["app-server-thread-status-check"]
      ],
      "allow_extra_args": true,
      "operations": ["test"]
    },
    {
      "programs": ["just"],
      "prefixes": [["validate-crate"], ["validate-crate-full"]],
      "allow_extra_args": true,
      "operations": ["lint", "test"]
    },
    {
      "programs": ["just"],
      "prefixes": [["fmt-check"], ["fmt-check-fast"], ["clippy-lane"]],
      "allow_extra_args": true,
      "operations": ["lint"]
    },
    {
      "programs": ["just"],
      "prefixes": [["check-lane"]],
      "allow_extra_args": true,
      "operations": ["check"]
    }
  ]
}
