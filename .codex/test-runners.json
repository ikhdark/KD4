{
  "version": 1,
  "runners": [
    {
      "programs": [
        "python",
        "python3",
        "py"
      ],
      "prefixes": [
        [
          "scripts/build/rust_build_status.py",
          "run-lane"
        ]
      ],
      "options": {
        "-I": 0,
        "-B": 0,
        "-u": 0
      },
      "allow_extra_args": true,
      "passthrough_after": "--",
      "admission_runner": "rust_build_status"
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "test-fast"
        ],
        [
          "test-lane"
        ],
        [
          "test-lane-main"
        ],
        [
          "test-lane-fast"
        ],
        [
          "test-lane-package"
        ]
      ],
      "allow_extra_args": true,
      "operations": [
        "test"
      ],
      "admission_runner": "rust_build_status"
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "test-fast-nosccache"
        ]
      ],
      "allow_extra_args": true,
      "operations": [
        "test"
      ]
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "hooks-schema-check"
        ]
      ],
      "allow_extra_args": false,
      "operations": [
        "test"
      ],
      "admission_runner": "rust_build_status"
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "fmt-check"
        ],
        [
          "fmt-check-fast"
        ]
      ],
      "allow_extra_args": true,
      "operations": [
        "lint"
      ]
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "clippy-lane"
        ],
        [
          "lint-rust"
        ]
      ],
      "allow_extra_args": true,
      "operations": [
        "lint"
      ],
      "admission_runner": "rust_build_status"
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "check-lane"
        ]
      ],
      "allow_extra_args": true,
      "operations": [
        "check"
      ],
      "admission_runner": "rust_build_status"
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "sdk-python-check"
        ],
        [
          "sdk-ts-check"
        ]
      ],
      "allow_extra_args": false,
      "operations": [
        "lint",
        "test"
      ]
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "test-compile"
        ]
      ],
      "allow_extra_args": true,
      "operations": [
        "check"
      ],
      "execution_mode": "compilation_only",
      "admission_runner": "rust_build_status"
    },
    {
      "programs": [
        "just"
      ],
      "prefixes": [
        [
          "cargo-lane"
        ],
        [
          "cargo-lane-isolated-home"
        ]
      ],
      "allow_extra_args": true,
      "passthrough_args": 2,
      "admission_runner": "rust_build_status"
    }
  ]
}
