{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kd4.local/schemas/replacement-admissions-v1.schema.json",
  "title": "KD4 replacement admissions V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_id",
    "schema_version",
    "predecessor_authority",
    "approval_receipts",
    "admissions",
    "semantic_sha256",
    "self_hash"
  ],
  "properties": {
    "format_id": { "const": "kd4.replacement-admissions.v1" },
    "schema_version": { "const": 1 },
    "predecessor_authority": { "$ref": "#/$defs/predecessorAuthority" },
    "approval_receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/approvalReceipt" }
    },
    "admissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/admission" }
    },
    "semantic_sha256": { "$ref": "#/$defs/sha256" },
    "self_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\./)(?!.*\\\\).+$"
    },
    "predecessorAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_path",
        "inventory_raw_sha256",
        "inventory_semantic_sha256",
        "ledger_path",
        "ledger_raw_sha256",
        "baseline_ids_sha256"
      ],
      "properties": {
        "inventory_path": { "const": ".codex/validation/frozen-test-inventory-v1.json" },
        "inventory_raw_sha256": { "const": "df230a7683f0f31f1aae4d3f7644af39cec67b09fadf8f3f1e6c60729d18196a" },
        "inventory_semantic_sha256": { "const": "a2fb8c0b806853b6375d92cfa6daf985ea35a5c4d4ecd49cf1d6da6f23359152" },
        "ledger_path": { "const": ".codex/validation/test-replacements-v1.json" },
        "ledger_raw_sha256": { "const": "210acb8428be83b9c6acd021bde4e44905e738d557ca89db60cb1271f65da46b" },
        "baseline_ids_sha256": { "const": "9100d0fe0dd4c270a1216b6d3ec6f6c39b7f93278cf68235f500edae17d25eb1" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_kind", "source_kind", "source_locator", "exact_text", "text_sha256"],
      "properties": {
        "actor_kind": { "const": "current-user" },
        "source_kind": { "enum": ["conversation", "repository-instruction"] },
        "source_locator": { "$ref": "#/$defs/nonemptyString" },
        "exact_text": { "$ref": "#/$defs/nonemptyString" },
        "text_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reviewerProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_kind", "reviewer_id", "source_kind", "source_locator", "verdict", "exact_text", "text_sha256"],
      "properties": {
        "actor_kind": { "const": "root-reviewer" },
        "reviewer_id": { "$ref": "#/$defs/nonemptyString" },
        "source_kind": { "enum": ["conversation", "repository-instruction"] },
        "source_locator": { "$ref": "#/$defs/nonemptyString" },
        "verdict": { "const": "approved" },
        "exact_text": { "$ref": "#/$defs/nonemptyString" },
        "text_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "approvalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_receipt_id", "admission_ids", "scope_sha256", "current_user", "reviewer", "receipt_sha256"],
      "properties": {
        "approval_receipt_id": { "type": "string", "pattern": "^replacement-approval-v1\\.[0-9a-f]{64}$" },
        "admission_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^replacement-admission-v1\\.[0-9a-f]{64}$" }
        },
        "scope_sha256": { "$ref": "#/$defs/sha256" },
        "current_user": { "$ref": "#/$defs/provenance" },
        "reviewer": { "$ref": "#/$defs/reviewerProvenance" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baselineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "inventory_entry_sha256", "ledger_row_sha256", "obligation_id"],
      "properties": {
        "baseline_id": { "$ref": "#/$defs/nonemptyString" },
        "inventory_entry_sha256": { "$ref": "#/$defs/sha256" },
        "ledger_row_sha256": { "$ref": "#/$defs/sha256" },
        "obligation_id": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "currentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id", "framework", "native_id", "source_path", "test_route_id", "validation_id",
        "runner_selector_sha256", "executable_identity_sha256", "execution_input_contract_sha256",
        "platform_applicability_sha256"
      ],
      "properties": {
        "test_id": { "$ref": "#/$defs/nonemptyString" },
        "framework": { "$ref": "#/$defs/nonemptyString" },
        "native_id": { "$ref": "#/$defs/nonemptyString" },
        "source_path": { "$ref": "#/$defs/relativePath" },
        "test_route_id": { "$ref": "#/$defs/nonemptyString" },
        "validation_id": { "$ref": "#/$defs/nonemptyString" },
        "runner_selector_sha256": { "$ref": "#/$defs/sha256" },
        "executable_identity_sha256": { "$ref": "#/$defs/sha256" },
        "execution_input_contract_sha256": { "$ref": "#/$defs/sha256" },
        "platform_applicability_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "raw_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "raw_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacement_id", "current_identity", "current_identity_sha256", "source_files",
        "runtime_path", "runtime_path_sha256", "contract_sources", "contract_sources_sha256",
        "validation_contract_sha256"
      ],
      "properties": {
        "replacement_id": { "$ref": "#/$defs/nonemptyString" },
        "current_identity": { "$ref": "#/$defs/currentIdentity" },
        "current_identity_sha256": { "$ref": "#/$defs/sha256" },
        "source_files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileBinding" } },
        "runtime_path": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonemptyString" } },
        "runtime_path_sha256": { "$ref": "#/$defs/sha256" },
        "contract_sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileBinding" } },
        "contract_sources_sha256": { "$ref": "#/$defs/sha256" },
        "validation_contract_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "replacement_id", "role", "preserved_behavior", "behavior_sha256"],
      "properties": {
        "baseline_id": { "$ref": "#/$defs/nonemptyString" },
        "replacement_id": { "$ref": "#/$defs/nonemptyString" },
        "role": { "enum": ["primary", "supplementary"] },
        "preserved_behavior": { "$ref": "#/$defs/nonemptyString" },
        "behavior_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "focusedValidationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id", "replacement_id", "report_path", "report_sha256", "attempt_id",
        "private_nonce_sha256", "exact_command", "repository_identity_sha256", "host_identity_sha256",
        "parent_process_sha256", "runner_identity_sha256", "child_runner_identities_sha256",
        "validation_id", "intended_count", "selected_count", "executed_count",
        "executed_validation_ids", "classification", "starting_workspace_fingerprint",
        "ending_workspace_fingerprint", "mutation_epoch", "selection_sha256", "resolved_inputs_sha256",
        "validation_execution_id", "eligibility_receipt_sha256", "receipt_sha256"
      ],
      "properties": {
        "admission_id": { "$ref": "#/$defs/nonemptyString" },
        "replacement_id": { "$ref": "#/$defs/nonemptyString" },
        "report_path": { "$ref": "#/$defs/relativePath" },
        "report_sha256": { "$ref": "#/$defs/sha256" },
        "attempt_id": { "$ref": "#/$defs/nonemptyString" },
        "private_nonce_sha256": { "$ref": "#/$defs/sha256" },
        "exact_command": { "$ref": "#/$defs/nonemptyString" },
        "repository_identity_sha256": { "$ref": "#/$defs/sha256" },
        "host_identity_sha256": { "$ref": "#/$defs/sha256" },
        "parent_process_sha256": { "$ref": "#/$defs/sha256" },
        "runner_identity_sha256": { "$ref": "#/$defs/sha256" },
        "child_runner_identities_sha256": { "$ref": "#/$defs/sha256" },
        "validation_id": { "$ref": "#/$defs/nonemptyString" },
        "intended_count": { "type": "integer", "minimum": 1 },
        "selected_count": { "type": "integer", "minimum": 1 },
        "executed_count": { "type": "integer", "minimum": 1 },
        "executed_validation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonemptyString" } },
        "classification": { "const": "confirmed-pass" },
        "starting_workspace_fingerprint": { "$ref": "#/$defs/sha256" },
        "ending_workspace_fingerprint": { "$ref": "#/$defs/sha256" },
        "mutation_epoch": { "$ref": "#/$defs/nonemptyString" },
        "selection_sha256": { "$ref": "#/$defs/sha256" },
        "resolved_inputs_sha256": { "$ref": "#/$defs/sha256" },
        "validation_execution_id": { "$ref": "#/$defs/nonemptyString" },
        "eligibility_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stage2Disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "register_path", "register_raw_sha256", "behavior_ids", "defect_receipt_sha256s"],
      "properties": {
        "disposition": { "enum": ["reviewed-no-incorrect-behavior", "incorrect-behavior-fixed"] },
        "register_path": { "const": ".codex/validation/stage2-incorrect-behaviors-v1.txt" },
        "register_raw_sha256": { "$ref": "#/$defs/sha256" },
        "behavior_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonemptyString" } },
        "defect_receipt_sha256s": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focused_validation_receipts", "stage2", "accepted_receipt_sha256"],
      "properties": {
        "focused_validation_receipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/focusedValidationReceipt" } },
        "stage2": { "$ref": "#/$defs/stage2Disposition" },
        "accepted_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id", "state", "approval_receipt_id", "baseline_bindings", "successors",
        "edges", "mapping_sha256", "product_behavior_obligation_sha256",
        "candidate_receipt_sha256", "acceptance"
      ],
      "properties": {
        "admission_id": { "type": "string", "pattern": "^replacement-admission-v1\\.[0-9a-f]{64}$" },
        "state": { "enum": ["focused-candidate", "accepted"] },
        "approval_receipt_id": { "type": "string", "pattern": "^replacement-approval-v1\\.[0-9a-f]{64}$" },
        "baseline_bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/baselineBinding" } },
        "successors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/successor" } },
        "edges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edge" } },
        "mapping_sha256": { "$ref": "#/$defs/sha256" },
        "product_behavior_obligation_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "acceptance": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/acceptance" }
          ]
        }
      }
    }
  }
}
