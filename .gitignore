# deps
# Node.js dependencies
node_modules
.pnpm-store
.pnpm-debug.log

# Keep pnpm-lock.yaml
!pnpm-lock.yaml

# build
/_build/
dist/
build/
# Tracked build tooling, not build output
!/scripts/build/
out/
storybook-static/

# ignore README for publishing
codex-cli/README.md

# ignore Nix derivation results
result

# editor
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.vs/
.history/
.zed/
*.swp
*~

# cli tools
CLAUDE.md
.claude/
AGENTS.override.md

# caches
.cache/
.turbo/
.parcel-cache/
.eslintcache
.nyc_output/
.jest/
.pytest_cache/
.ruff_cache/
*.tsbuildinfo
/target/
/target-*/
/lanes/
# Cargo output from repository-relative target paths run inside codex-rs.
/codex-rs/codex-rs/target/
*.pdb

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env*
!.env.example
.venv/

# package
*.tgz
*.whl

# ci
.vercel/
.netlify/

# temporary files
/.tmp/
*.tmp
*.bak

# patches
apply_patch/

# coverage
coverage/

# Historical performance reports
/audits_benchmarks

# Local documentation
/docs/
/audits/

# personal files
/current-diff.txt
# Local diff dumps; use .scratch/ for new scratch output.
/.d[0-9a-f].txt
/.e[0-9a-f].txt
/.scratch/
personal/
/kd-ui/
# Local configuration and generated evidence (tracked files stay tracked).
/.kda/
/.codex/config.toml
/.codex/auth.json
/.codex/harness/targets/
.codex/locks/
/.codex/diagnostics/
/.codex/audits/
/.codex/gitdiff/
/.codex/benchmark-runs/
/.codex/tmp/

# os
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
Icon?
.Spotlight-V100/

# Unwanted package managers
.yarn/
yarn.lock

# release
package.json-e
session.ts-e
CHANGELOG.ignore.md

# nix related
.direnv
.envrc

# Python bytecode files
__pycache__/
*.py[co]

# Retired repository map/ownership artifacts and generators. Do not restore.
/SOURCEMAP.md
/source_owners.toml
/architecture_index.json
/scripts/source_map_check.py
/scripts/test_source_map_check.py
/scripts/source_owners.py
/scripts/test_source_owners.py
