{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "JSONRPCErrorError": {
      "properties": {
        "code": {
          "format": "int64",
          "type": "integer"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "int64",
          "maximum": 9007199254740991.0,
          "minimum": -9007199254740991.0,
          "type": "integer"
        }
      ],
      "description": "A request identifier. Numeric IDs must be integers in the inclusive range -9007199254740991 to 9007199254740991 (JavaScript safe integers). Use a string ID outside this range to preserve identity in JavaScript clients."
    }
  },
  "description": "A response to a request that indicates an error occurred.",
  "properties": {
    "error": {
      "$ref": "#/definitions/JSONRPCErrorError"
    },
    "id": {
      "$ref": "#/definitions/RequestId"
    }
  },
  "required": [
    "error",
    "id"
  ],
  "title": "JSONRPCError",
  "type": "object"
}