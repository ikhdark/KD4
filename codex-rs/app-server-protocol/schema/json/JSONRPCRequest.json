{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "RequestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "int64",
          "maximum": 9007199254740991.0,
          "minimum": -9007199254740991.0,
          "type": "integer"
        }
      ],
      "description": "A request identifier. Numeric IDs must be integers in the inclusive range -9007199254740991 to 9007199254740991 (JavaScript safe integers). Use a string ID outside this range to preserve identity in JavaScript clients."
    },
    "W3cTraceContext": {
      "properties": {
        "traceparent": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracestate": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "description": "A request that expects a response.",
  "properties": {
    "id": {
      "$ref": "#/definitions/RequestId"
    },
    "method": {
      "type": "string"
    },
    "params": true,
    "trace": {
      "anyOf": [
        {
          "$ref": "#/definitions/W3cTraceContext"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional W3C Trace Context for distributed tracing."
    }
  },
  "required": [
    "id",
    "method"
  ],
  "title": "JSONRPCRequest",
  "type": "object"
}