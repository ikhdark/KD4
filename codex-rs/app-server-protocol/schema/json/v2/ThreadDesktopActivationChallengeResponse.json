{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DesktopActivationChallenge": {
      "properties": {
        "activationObligationIdentity": {
          "type": "string"
        },
        "challengeId": {
          "type": "string"
        },
        "evidenceEpoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "expectedInstalledExecutablePath": {
          "type": "string"
        },
        "expectedInstalledExecutableSha256": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "implementationIdentity": {
          "type": "string"
        },
        "issuedAt": {
          "type": "string"
        },
        "publishId": {
          "type": "string"
        },
        "publisherEvidenceId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "activationObligationIdentity",
        "challengeId",
        "evidenceEpoch",
        "expectedInstalledExecutablePath",
        "expectedInstalledExecutableSha256",
        "expiresAt",
        "implementationIdentity",
        "issuedAt",
        "publishId",
        "publisherEvidenceId",
        "threadId"
      ],
      "type": "object"
    },
    "DesktopActivationUnavailableReason": {
      "enum": [
        "noCurrentActivationObligation",
        "noAuthoritativeBootstrapEvidence",
        "bootstrapEvidenceMalformed",
        "bootstrapEvidenceMismatch",
        "bootstrapEvidenceStale",
        "runningExecutableMismatch",
        "challengeExpired",
        "challengeMissingOrConsumed",
        "activationObligationChanged",
        "invalidDesktopObservation",
        "replayPayloadMismatch",
        "persistenceFailed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "challenge": {
      "anyOf": [
        {
          "$ref": "#/definitions/DesktopActivationChallenge"
        },
        {
          "type": "null"
        }
      ]
    },
    "unavailableReason": {
      "anyOf": [
        {
          "$ref": "#/definitions/DesktopActivationUnavailableReason"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "ThreadDesktopActivationChallengeResponse",
  "type": "object"
}