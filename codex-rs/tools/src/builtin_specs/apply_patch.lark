begin_patch: "*** Begin Patch" LF
operation_id: "*** Operation ID: " /[A-Za-z0-9_.:-]{1,128}/ LF
end_patch: "*** End Patch" LF?

revision_guard: "*** Guard File: " filename LF "*** Expect: " revision LF
revision: /sha256:[0-9a-fA-F]{64}/ | "absent"

hunk: add_hunk | delete_hunk | update_hunk
add_hunk: "*** Add File: " filename LF add_line*
delete_hunk: "*** Delete File: " filename LF
update_hunk: "*** Update File: " filename LF (change_move change? | change)

filename: /(.+)/
add_line: "+" /(.+)/? LF -> line

change_move: "*** Move to: " filename LF
change: (change_context | change_line)+ eof_line?
change_context: ("@@" | "@@ " /(.+)/) LF
change_line: ("+" | "-" | " ") /(.+)/? LF
eof_line: "*** End of File" LF

%import common.LF

retry: "*** Retry Patch: " patch_id LF amendment*
amendment: "*** Replace Hunk: " index LF hunk | "*** Replace Chunk: " index " " index LF change
patch_id: /[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/
index: /[1-9][0-9]*/
