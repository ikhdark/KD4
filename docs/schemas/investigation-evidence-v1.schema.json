{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/kd4/investigation-evidence-v1.schema.json",
  "title": "Investigation evidence result version 1",
  "description": "Common evidence envelope for KDS, KDWG, and Repo Atlas provider results.",
  "type": "object",
  "required": [
    "evidenceMeta"
  ],
  "properties": {
    "evidenceMeta": {
      "$ref": "#/$defs/evidenceMeta"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidenceMeta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "producer",
        "operation",
        "evidenceBearing",
        "payloadCompleteness",
        "truncated",
        "approximate",
        "limitations",
        "snapshot"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "producer": {
          "enum": [
            "kds",
            "kdwg",
            "repo-atlas"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "evidenceBearing": {
          "type": "boolean"
        },
        "payloadCompleteness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "approximate": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "snapshot": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "payloadCompleteness": {
                "const": "complete"
              }
            },
            "required": [
              "payloadCompleteness"
            ]
          },
          "then": {
            "properties": {
              "truncated": {
                "const": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
