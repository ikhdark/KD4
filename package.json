{
  "name": "codex-monorepo",
  "private": true,
  "description": "Tools for repo-wide maintenance.",
  "scripts": {
    "format": "node scripts/maintenance/run-python.js scripts/maintenance/format.py --check --only prettier",
    "format:fix": "node scripts/maintenance/run-python.js scripts/maintenance/format.py --write --only prettier",
    "format:python": "node scripts/maintenance/run-python.js scripts/maintenance/format.py --check --only python-scripts",
    "format:python:fix": "node scripts/maintenance/run-python.js scripts/maintenance/format.py --write --only python-scripts",
    "lint:markdown": "markdownlint-cli2"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.18.1",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
