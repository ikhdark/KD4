{
  "name": "codex-monorepo",
  "private": true,
  "description": "Tools for repo-wide maintenance.",
  "scripts": {
    "audit:scripts": "node scripts/run-python.js scripts/root_maintenance.py audit-scripts",
    "format": "prettier --check *.json *.md docs/*.md **/*.js",
    "format:fix": "prettier --write *.json *.md docs/*.md **/*.js",
    "format:python": "node scripts/run-python.js scripts/root_maintenance.py format-python",
    "format:python:fix": "node scripts/run-python.js scripts/root_maintenance.py format-python --write",
    "lint:markdown": "markdownlint-cli2",
    "lint:python": "node scripts/run-python.js scripts/root_maintenance.py lint-python",
    "lint:python:fix": "node scripts/run-python.js scripts/root_maintenance.py lint-python --fix",
    "test:scripts": "node scripts/run-python.js scripts/root_maintenance.py test-python",
    "test:scripts:target": "node scripts/run-python.js scripts/root_maintenance.py test-python --changed",
    "test:scripts:changed": "node scripts/run-python.js scripts/root_maintenance.py test-python --changed",
    "write-hooks-schema": "cargo run --manifest-path ./codex-rs/Cargo.toml -p codex-hooks --bin write_hooks_schema_fixtures"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.18.1",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
