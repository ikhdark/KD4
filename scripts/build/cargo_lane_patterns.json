{
  "lane_path_pattern": "target[\\\\/]+lanes[\\\\/]+([A-Za-z0-9_.-]+)",
  "script_lane_pattern": "(?:^|\\s)(?:(?i:-Lane)(?:\\s+|:\\s*)|--lane(?:\\s+|=))[\"']?(?!(?i:auto)[\"']?(?=\\s|$))([A-Za-z0-9_.-]+)[\"']?(?=\\s|$)",
  "just_lane_pattern": "\\b(?:cargo-lane(?:-(?:home|isolated-home))?|check-lane|clippy-lane|watch-lane|fix-lane)\\s+[\"']?(?!(?i:auto)[\"']?(?=\\s|$))([A-Za-z0-9_.-]+)[\"']?(?=\\s|$)",
  "just_fixed_lane_pattern": "\\b(release-lane)\\b",
  "just_fixed_lane_names": {
    "release-lane": "release"
  }
}
