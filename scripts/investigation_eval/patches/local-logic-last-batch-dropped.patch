@@ -0,0 +1,14 @@
+fn batches<T>(items: &[T], width: usize) -> Vec<&[T]> {
+    if width == 0 {
+        return Vec::new();
+    }
+
+    let mut result = Vec::new();
+    let mut start = 0;
+    while start.saturating_add(width) < items.len() {
+        let end = start.saturating_add(width).min(items.len());
+        result.push(&items[start..end]);
+        start = end;
+    }
+    result
+}
