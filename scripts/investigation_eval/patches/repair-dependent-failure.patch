+def apply_then_consume(producer, consumer):
+    try:
+        value = producer()
+    except RuntimeError:
+        return None
+    return consumer(value)
diff --git a/investigation_cases/test_repair_dependent_failure.py b/investigation_cases/test_repair_dependent_failure.py
new file mode 100644
