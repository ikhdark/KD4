+import unittest
+
+from repair_preserve_context import model_visible_messages
+
+
+class ModelVisibleMessagesTests(unittest.TestCase):
+    def test_preserves_all_supplied_context(self):
+        messages = ["system", "request", "constraint", "finding", "tool", "result"]
+
+        self.assertEqual(model_visible_messages(messages), messages)
+
+
+if __name__ == "__main__":
+    unittest.main()
