@@ -0,0 +1,31 @@
+import unittest
+
+from repair_ready_signal import ReadySignal
+
+
+class ReadySignalTests(unittest.TestCase):
+    def test_subscriber_before_ready_is_notified(self):
+        signal = ReadySignal()
+        calls = []
+        signal.on_ready(lambda: calls.append("ready"))
+        signal.mark_ready()
+        self.assertEqual(calls, ["ready"])
+
+    def test_subscriber_after_ready_is_notified_immediately(self):
+        signal = ReadySignal()
+        calls = []
+        signal.mark_ready()
+        signal.on_ready(lambda: calls.append("ready"))
+        self.assertEqual(calls, ["ready"])
+
+    def test_repeated_ready_does_not_duplicate_notifications(self):
+        signal = ReadySignal()
+        calls = []
+        signal.on_ready(lambda: calls.append("ready"))
+        signal.mark_ready()
+        signal.mark_ready()
+        self.assertEqual(calls, ["ready"])
+
+
+if __name__ == "__main__":
+    unittest.main()
