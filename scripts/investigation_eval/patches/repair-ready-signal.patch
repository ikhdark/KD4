+class ReadySignal:
+    def __init__(self):
+        self._ready = False
+        self._callbacks = []
+
+    def mark_ready(self):
+        if self._ready:
+            return
+        self._ready = True
+        callbacks = self._callbacks
+        self._callbacks = []
+        for callback in callbacks:
+            callback()
+
+    def on_ready(self, callback):
+        self._callbacks.append(callback)
