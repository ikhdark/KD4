{
  "name": "@openai/codex-sdk",
  "version": "0.0.0-dev",
  "description": "TypeScript SDK for Codex APIs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openai/codex.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "openai",
    "codex",
    "sdk",
    "typescript",
    "api"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "lint": "pnpm eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "pnpm eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit --rootDir . --allowImportingTsExtensions",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "node -e \"if (process.env.CODEX_SDK_SKIP_PREPARE !== '1') require('node:child_process').execSync('pnpm run build', {stdio: 'inherit'})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-plugin-node-import": "^1.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-jest-mock-import-meta": "^1.3.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
